@using Dictionary.Shared.Database.Entities
@using Dictionary.Shared.Resources.Translations
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

@* Forget about using a constant here. You cannot incorporate a string variable to the @page directive. Put up with it. *@
@page "/questionnaire"
@inherits QuestionnaireBase

@if (IsLoading)
{
    <div class="min-vh-100 d-flex align-items-center justify-content-center">
        <h3 class="fw-bold">
            @* Do not use an HTML entity for three dots. It's slightly higher than letters and looks awful. *@
            @($"{Localizer[DictionaryTranslations.Loading]}...")
        </h3>
        @* Do not use a spinner here, it's laggy on Android. *@
    </div>
}
else
{
    <div class="mb-5 p-5">
        <p class="p-3 w-100">
            <h3 class="fw-bolder">
                @ActualText
            </h3>
        </p>

        @if (IsLastWordShown || CzechPointer < (GeneratedCzechs.Count - 1))
        {
            foreach (var actualWord in ActualWords)
            {
                <div class="border border-dark mb-3 px-3 rounded word-div">
                    <div class="align-middle">
                        <span class="fw-bolder">
                            @($"{actualWord.Article} {actualWord.Text}")
                        </span>
                        <span>
                            @if (actualWord.Notes is string notes)
                            {
                                @($"({notes}) [{actualWord.Ipa}]")
                            }
                            else
                            {
                                @($"[{actualWord.Ipa}]")
                            }
                        </span>
                    </div>
                </div>
            }
        }
        else
        {
            <div
                class="border border-dark button-div d-inline-block p-3 rounded"
                @onclick="ShowWord">
                <svg
                    fill="#000000"
                    version="1.1"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                    height="100%"
                    viewBox="0 0 64 64"
                    enable-background="new 0 0 64 64"
                    xml:space="preserve">
                    <g>
                        <path d="M52,64c2.206,0,4-1.794,4-4V4c0-2.206-1.794-4-4-4H26c-1.638,0-3.668,0.841-4.828,2L10,13.171C8.841,14.33,8,16.36,8,18v42
                            c0,2.206,1.794,4,4,4H52z M52,4l0,56h0H12V18h10c2.206,0,4-1.794,4-4V4H52z M22,6.828V14h-7.172L22,6.828z" />
                        <path d="M32,16h12c1.104,0,2-0.896,2-2s-0.896-2-2-2H32c-1.104,0-2,0.896-2,2S30.896,16,32,16z" />
                        <path d="M44,22H20c-1.104,0-2,0.896-2,2s0.896,2,2,2h24c1.104,0,2-0.896,2-2S45.104,22,44,22z" />
                        <path d="M44,32H20c-1.104,0-2,0.896-2,2s0.896,2,2,2h24c1.104,0,2-0.896,2-2S45.104,32,44,32z" />
                        <path d="M44,42H20c-1.104,0-2,0.896-2,2s0.896,2,2,2h24c1.104,0,2-0.896,2-2S45.104,42,44,42z" />
                        <path d="M44,52H20c-1.104,0-2,0.896-2,2s0.896,2,2,2h24c1.104,0,2-0.896,2-2S45.104,52,44,52z" />
                    </g>
                </svg>
            </div>
        }

        <div class="mt-5">
            <button
                class="border border-dark btn btn-lg btn-primary col-auto dictionary-button mb-2 me-2 @PreviousWordButtonDisabled"
                @onclick="async () => await ClickPreviousWordButtonAsync()">
                @Localizer[DictionaryTranslations.Previous]
            </button>

            <button
                class="border border-dark btn btn-lg btn-primary col-auto dictionary-button mb-2 me-2 @NextWordButtonDisabled"
                @onclick="async () => await ClickNextWordButtonAsync()">
                @Localizer[DictionaryTranslations.Next]
            </button>

            <span class="align-middle col-auto fw-bold h1-fixed mb-0 mx-0 text-primary">
                @Done
            </span>
        </div>

        <div class="fw-bolder pt-4">
            <table class="table table-borderless w-auto">
                <tr>
                    <td class="text-nowrap">@Localizer[DictionaryTranslations.WordsViewed]:</td>
                    <td class="px-2">@WordsShownCount</td>
                </tr>
            </table>
        </div>

        <div class="fw-bolder pt-4">
            @*
            The href="" causes Blazor to apply the 'active' class to the NavLink when on the /questionnaire route.
            This class is applied to all links having the href value as prefix, and the empty value is prefix of everythign.
            Applying the class causes setting the background to darker gray instead of the desired light gray.
            The NavLinkMatch.All ensures that the class would be applied only if the current route exactly matched the href value.
            *@
            <NavLink class="border border-dark btn btn-light btn-lg dictionary-button" href="" Match="NavLinkMatch.All">
                @Localizer[DictionaryTranslations.Restart]
            </NavLink>
        </div>
    </div>
}
