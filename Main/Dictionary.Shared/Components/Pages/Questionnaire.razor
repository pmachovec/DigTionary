@using Dictionary.Shared.Resources.Translations

@* Forget about using a constant here. You cannot incorporate a string variable to the @page directive. Put up with it. *@
@page "/questionnaire"
@inherits QuestionnaireBase

<div class="fw-bolder" hidden="@(!IsLoading)">
    @($"{Localizer[DictionaryTranslations.Loading]}...")
</div>

<div class="w-100" hidden="@IsLoading">
    <p class="p-3 w-100">
        <h3 class="fw-bolder">
            @Text
        </h3>
    </p>
    <p class="border border-dark p-3 w-100">
        Result
    </p>
</div>
