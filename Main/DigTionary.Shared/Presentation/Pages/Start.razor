@using DigTionary.Shared.Presentation.Constants
@using DigTionary.Shared.Presentation.Pages.StartComponents
@using DigTionary.Shared.Resources.Translations
@using Microsoft.AspNetCore.Components.Web

@page "/"
@inherits StartBase

@*
Extra bottom margin is necessary for phones that use virtual navigation buttons (which is typical).
On such phones, buttos at the bottom of the screen can get partially covered by the navigation buttons.
Do not put it to the main layout or index.html, it messes loading screens.
*@
<div class="mb-5 p-5">
    <hr />

    <div class="fw-bolder h3 px-1 py-3 text-nowrap">
        @Localizer[DigTionaryTranslations.Configuration]
    </div>

    <div class="fw-bolder h5 pt-3 px-1 text-nowrap">
        @Localizer[DigTionaryTranslations.Mode]
    </div>

    <div class="d-inline-flex gap-3 pb-3">
        <button
            class="@FLAG_BUTTON_CLASSES @CzToLangButtonPrimary"
            @onclick="ToggleCzToLang">
            <FlagCz />
            <span class="lead">&#x2794;</span> @* Right arrow *@
            <FlagDe />
        </button>
        <button
            class="@FLAG_BUTTON_CLASSES @LangToCzButtonPrimary"
            @onclick="ToggleLangToCz">
            <FlagDe />
            <span class="lead">&#x2794;</span> @* Right arrow *@
            <FlagCz />
        </button>
    </div>

    <div class="fw-bolder h5 pt-5 px-1 text-nowrap">
        @Localizer[DigTionaryTranslations.ChaptersSelection]
    </div>

    <div class="container-fluid pb-3 px-0 text-start">
        <div class="row gx-4">
            @foreach (var category in Categories)
            {
                <div class="col-auto">
                    <div class="form-check form-switch form-switch-scalable py-3">
                        <input
                            id="@($"{IdsPartial.CATEGORY}{category.Id}")"
                            class="form-check-input"
                            type="checkbox"
                            role="switch"
                            checked="@IsCategorySelected(category.Id)"
                            @onchange="(e => OnCategoryChange(e, category))">
                        <label class="form-check-label fw-bolder h6" for="@($"{IdsPartial.CATEGORY}{category.Id}")">
                            @category.Name
                        </label>
                    </div>

                    @foreach (var lesson in category.Lessons)
                    {
                        <div class="form-check form-switch py-2">
                            <input
                                id="@($"{IdsPartial.LESSON}{lesson.Id}")"
                                class="form-check-input"
                                type="checkbox"
                                role="switch"
                                checked="@IsLessonSelected(lesson.Id)"
                                @onchange="(e => OnLessonChange(e, lesson))">
                            <label class="form-check-label" for="@($"{IdsPartial.LESSON}{lesson.Id}")">
                                @lesson.Name
                            </label>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <hr />

    <div class="fw-bolder" id="start-button-div">
        <button
            class="border border-dark btn btn-primary btn-lg digtionary-button @StartButtonDisabled"
            @onclick="Start">
            @Localizer[DigTionaryTranslations.Start]
        </button>
    </div>
</div>
