@using DigTionary.Shared.Presentation.Pages.QuestionnaireComponents

@* Forget about using a constant here. You cannot incorporate a string variable to the @page directive. Put up with it. *@
@page "/questionnaire"
@inherits QuestionnaireBase

<div class="questionnaire-root">
    @if (IsLoading)
    {
        <Loading />
    }
    else if (QuestionnaireParams.CzToLang)
    {
        <CzToLang />
    }
    else
    {
        <LangToCz />
    }
</div>
