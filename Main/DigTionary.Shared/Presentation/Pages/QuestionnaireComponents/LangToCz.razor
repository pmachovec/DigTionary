@using DigTionary.Shared.Presentation.Pages.QuestionnaireComponents.Shared
@using Microsoft.AspNetCore.Components.Web

@inherits LangToCzBase

<div class="mb-5 p-5">
    <hr />

    <p class="px-1 py-3 w-100">
        <h3 class="fw-bolder">
            @ActualWordText
        </h3>
    </p>

    @if (IsLastWordShown || WordPointer < (GeneratedWordsByText.Count - 1))
    {
        foreach (var actualWord in ActualWords)
        {
            <div class="mb-3 p-3 rounded word-div-outer">
                <div class="word-div-inner">
                    <span class="fw-bolder">
                        @($"{actualWord.Article ?? string.Empty} {actualWord.Text}".Trim())
                    </span>

                    @if (actualWord.Notes is string notes)
                    {
                        <span>
                            @($"({notes})")
                        </span>
                    }

                    <span>
                        @($"[{actualWord.Ipa}]")
                    </span>
                </div>
                <div>
                    <ul class="px-3 m-0">
                        @foreach (var czech in actualWord.Czechs)
                        {
                            <li>
                                @czech.Text
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    }
    else
    {
        <div class="border border-dark button-div d-inline-block p-3 rounded"
            @onclick="ShowWord">
            <Sheet />
        </div>
    }

    <Navigation
        @ref="Navigation"
        ClickPreviousWordButton="ClickPreviousWordButton"
        ClickNextWordButton="ClickNextWordButton" />

    <Restart />
</div>
