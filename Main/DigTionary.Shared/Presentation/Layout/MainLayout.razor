@using DigTionary.Shared.Resources.Translations

@inherits MainLayoutBase

@*
d-inline-block = Minimum widh fits to content.
min-vw-100 = Minimum width is 100% of viewport width. This prevents the content from being squeezed when the screen is narrow.

Do not try to set global margin or padding here. It messes vertically alligned screens, e.g., loading screens.
*@
<div class="d-inline-block min-vw-100">
    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span id="unhandled-error">@Localizer[DigTionaryTranslations.UnhandledErrorOccured]</span>.
    <a href="." class="reload"><span id="reload">@Localizer[DigTionaryTranslations.Reload]</span></a>
    <span class="dismiss">🗙</span>
</div>
