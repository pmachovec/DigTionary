@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(Presentation.Layout.MainLayout).Assembly" NotFoundPage="typeof(Presentation.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Presentation.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
